# ================================================================
# SHEETFLOW ENVIRONMENT VARIABLES
# ================================================================

# App configuration
APP_URL=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL Database Connection URL
# Example: postgresql://username:password@ep-cool-cloud-12345.us-east-2.aws.neon.tech/sheetflow?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/sheetflow?sslmode=require

# Google Cloud OAuth 2.0 Credentials
# Create in Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI: http://localhost:3000/api/google/callback (or https://your-domain.vercel.app/api/google/callback)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authentication & Encryption Secrets (min 32 random characters)
AUTH_SECRET=generate-a-strong-random-secret-key-32-chars-min
ENCRYPTION_SECRET=generate-another-strong-32-char-key-for-oauth-token-aes256
